{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm ci --prefix backend && npm ci --prefix frontend",
  "buildCommand": "npm --prefix frontend run build",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/[...path].js": {
      "maxDuration": 30
    },
    "api/auth/[...path].js": {
      "maxDuration": 30
    },
    "api/vehicles/[...path].js": {
      "maxDuration": 30
    },
    "api/locations/[...path].js": {
      "maxDuration": 30
    },
    "api/locations/update.js": {
      "maxDuration": 30
    },
    "api/trips/[...path].js": {
      "maxDuration": 30
    },
    "api/trips/status.js": {
      "maxDuration": 30
    },
    "api/drivers/[...path].js": {
      "maxDuration": 30
    },
    "api/incidents/[...path].js": {
      "maxDuration": 30
    },
    "api/notifications/[...path].js": {
      "maxDuration": 30
    },
    "api/notifications/read.js": {
      "maxDuration": 30
    },
    "api/assignments/[...path].js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
